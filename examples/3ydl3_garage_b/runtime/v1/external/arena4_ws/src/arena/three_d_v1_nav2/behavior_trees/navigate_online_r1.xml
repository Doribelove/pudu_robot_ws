<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <PipelineSequence name="OnlineFrozenR1">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="FrozenR1"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="stopped_goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
