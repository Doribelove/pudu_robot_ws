+    FollowPath:
+      plugin: "nav2_teb_controller::TEBController"
+      path_tracker:
+        activate: true
+      trajectory:
+        reinit_dist: 2.0
+        reinit_angle: 3.14159
+        reinit_path_dist: 0.35
+        auto_resize: true
+        dt_ref: 0.30
+        dt_hyst: 0.05
+        min_samples: 3
+        max_samples: 40
+        min_seg_length: 0.025
+        max_seg_length: 0.35
+        max_angle_diff: 0.25
+        overwrite_plan_orientation: true
+        # Turn to face a new route before translating; reverse remains a
+        # feasible optimized escape maneuver after initialization.
+        allow_init_backward: false
+        control_look_ahead_poses: 2
+        max_global_plan_lookahead_dist: 2.5
+        global_plan_prune_distance: 0.25
