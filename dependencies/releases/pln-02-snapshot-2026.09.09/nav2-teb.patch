+  const int segments = std::max(
+      1, static_cast<int>(std::ceil(extension_distance / std::max(maximum_step, 1e-3))));
+  const double ds = extension_distance / static_cast<double>(segments);
+  for (int i = 0; i < segments; ++i) {
+    geometry_msgs::msg::PoseStamped extension = path.poses.back();
+    const double heading = PoseSE2(extension.pose).theta();
+    const double next_heading = heading + terminal_curvature * ds;
+    if (std::abs(terminal_curvature) <= 1e-9) {
+      extension.pose.position.x += ds * std::cos(heading);
+      extension.pose.position.y += ds * std::sin(heading);
+    } else {
+      extension.pose.position.x +=
+          (std::sin(next_heading) - std::sin(heading)) / terminal_curvature;
+      extension.pose.position.y +=
+          (-std::cos(next_heading) + std::cos(heading)) / terminal_curvature;
+    }
+    extension.pose.orientation.x = 0.0;
+    extension.pose.orientation.y = 0.0;
+    extension.pose.orientation.z = std::sin(0.5 * next_heading);
+    extension.pose.orientation.w = std::cos(0.5 * next_heading);
+    path.poses.push_back(extension);
