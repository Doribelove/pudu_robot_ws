+nav_msgs::msg::Path makeArcPath(size_t n_poses, double spacing, double height) {
+  nav_msgs::msg::Path path;
+  path.header.frame_id = "map";
+  path.poses.reserve(n_poses);
+  for (size_t i = 0; i < n_poses; ++i) {
+    geometry_msgs::msg::PoseStamped pose;
+    const double progress = static_cast<double>(i) / static_cast<double>(n_poses - 1);
+    pose.pose.position.x = static_cast<double>(i) * spacing;
+    pose.pose.position.y = height * std::sin(std::numbers::pi * progress);
+    pose.pose.orientation.w = 1.0;
+    path.poses.push_back(pose);
+  }
+  return path;
+}
