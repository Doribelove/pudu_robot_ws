+double pathCurvatureSpeedLimit(const nav_msgs::msg::Path &path, double max_speed,
+                              double max_angular_speed, double lateral_acceleration,
+                              double braking_acceleration) {
+  if (lateral_acceleration <= 0.0) return max_speed;
+  double limit = max_speed;
+  double progress = 0.0;
+  for (size_t i = 1; i < path.poses.size(); ++i) {
+    const auto &a = path.poses[i - 1].pose;
+    const auto &b = path.poses[i].pose;
+    const double length = std::hypot(b.position.x - a.position.x, b.position.y - a.position.y);
+    if (length < 1e-6) continue;
+    const double angle = angles::shortest_angular_distance(tf2::getYaw(a.orientation), tf2::getYaw(b.orientation));
+    const double curvature = std::abs(2.0 * std::sin(angle / 2.0)) / length;
+    if (curvature > 1e-6) {
+      const double curve_speed = std::min(std::sqrt(lateral_acceleration / curvature),
+                                          max_angular_speed / curvature);
+      const double available = std::max(0.0, progress - 0.5);
+      limit = std::min(limit, std::sqrt(curve_speed * curve_speed +
+                                       2.0 * braking_acceleration * available));
+    }
+    progress += length;
+  }
+  return limit;
+}
