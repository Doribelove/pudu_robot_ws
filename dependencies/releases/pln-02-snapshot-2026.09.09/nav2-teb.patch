+TEST(TebUtils, ResizePreservesGeometryAtHighSpeed) {
+  TimedElasticBand band;
+  band.addPose(0.0, 0.0, 0.0);
+  for (int i = 1; i <= 10; ++i)
+    band.addPoseAndTimeDiff(PoseSE2(i * .5, 0.0, 0.0), .2);
+  autoResize(band, .3, .05, .025, .3, .15, 3, 50, false);
+  for (size_t i = 1; i < band.sizePoses(); ++i)
+    EXPECT_LE((band.pose(i).position() - band.pose(i - 1).position()).norm(), .3);
+  EXPECT_NEAR(band.accumulatedDistance(), 5.0, 1e-8);
+}
+
+TEST(TebUtils, CurvatureEnvelopeSlowsBeforeBendsAndAllowsStraightCruise) {
+  nav_msgs::msg::Path path;
+  for (int i = 0; i <= 50; ++i) {
+    geometry_msgs::msg::PoseStamped pose;
+    pose.pose.position.x = i * .1;
+    pose.pose.orientation.w = 1.0;
+    path.poses.push_back(pose);
+  }
+  EXPECT_DOUBLE_EQ(pathCurvatureSpeedLimit(path, 2.5, 1.5, .5, 1.25), 2.5);
+  for (size_t i = 0; i < path.poses.size(); ++i) {
+    const double angle = static_cast<double>(i) * .1;
+    path.poses[i].pose.position.x = std::sin(angle);
+    path.poses[i].pose.position.y = 1.0 - std::cos(angle);
+    path.poses[i].pose.orientation = nav2_util::geometry_utils::orientationAroundZAxis(angle);
+  }
+  EXPECT_NEAR(pathCurvatureSpeedLimit(path, 2.5, 1.5, .5, 1.25), std::sqrt(.5), 1e-8);
+  EXPECT_DOUBLE_EQ(pathCurvatureSpeedLimit(path, 2.5, 1.5, 0.0, 1.25), 2.5);
+}
