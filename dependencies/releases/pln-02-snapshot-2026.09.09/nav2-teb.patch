+double terminalPathCurvature(const nav_msgs::msg::Path &path, double maximum_curvature) {
+  double curvature = 0.0;
+  if (path.poses.size() >= 2) {
+    const PoseSE2 previous(path.poses[path.poses.size() - 2].pose);
+    const PoseSE2 goal(path.poses.back().pose);
+    const double segment_length = (goal.position() - previous.position()).norm();
+    if (segment_length > 1e-9) {
+      curvature = angles::shortest_angular_distance(previous.theta(), goal.theta()) /
+                  segment_length;
+      if (maximum_curvature > 1e-12) {
+        curvature = std::clamp(curvature, -maximum_curvature, maximum_curvature);
+      }
+    }
+  }
+  return curvature;
+}
