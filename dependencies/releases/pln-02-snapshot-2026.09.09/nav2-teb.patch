+        min_prune_distance: 0.025
+      robot:
+        footprint:
+          use_local_costmap: false
+          model: "circles"
+          points: "[[-0.1275, 0.0, 0.25], [0.1275, 0.0, 0.25]]"
+        robot_model: "skid_steer"
+        wheelbase: 0.50
+        v_max_x: 1.2
+        v_max_x_backwards: 0.4
+        v_max_y: 0.0
+        v_max_theta: 1.8
+        a_max_x: 2.5
+        a_max_y: 0.0
+        a_max_theta: 2.0
+        jerk_max_x: 3.0
+        jerk_max_y: 0.0
+        jerk_max_theta: 4.0
+        min_turning_radius: 0.0
+        has_steering: false
+        use_proportional_saturation: true
