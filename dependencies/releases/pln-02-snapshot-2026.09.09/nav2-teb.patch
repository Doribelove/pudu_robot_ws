+Eigen::Vector2d closestPointOnPath(
+    const Eigen::Vector2d &query,
+    const std::vector<Eigen::Vector2d, Eigen::aligned_allocator<Eigen::Vector2d>> &path) {
+  if (path.empty())
+    return query;
+  if (path.size() == 1)
+    return path.front();
+
+  Eigen::Vector2d closest = path.front();
+  double min_squared_distance = std::numeric_limits<double>::max();
+  for (std::size_t i = 1; i < path.size(); ++i) {
+    const Eigen::Vector2d segment = path[i] - path[i - 1];
+    const double squared_length = segment.squaredNorm();
+    const double interpolation =
+        squared_length > 1e-12
+            ? std::clamp((query - path[i - 1]).dot(segment) / squared_length, 0.0, 1.0)
+            : 0.0;
+    const Eigen::Vector2d candidate = path[i - 1] + interpolation * segment;
+    const double squared_distance = (query - candidate).squaredNorm();
+    if (squared_distance < min_squared_distance) {
+      min_squared_distance = squared_distance;
+      closest = candidate;
+    }
+  }
+  return closest;
+}
