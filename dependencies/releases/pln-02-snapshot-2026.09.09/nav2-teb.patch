+
+  geometry_msgs::msg::Twist disabled = command;
+  EXPECT_FALSE(limitVelocityNearGoal(disabled, 0.001, 0.0, 0.02, 0.80));
+}
+
+TEST(TebUtils, ForwardGoalExtensionPreservesGoalHeading) {
+  nav_msgs::msg::Path path;
+  geometry_msgs::msg::PoseStamped goal;
+  goal.pose.position.x = 1.0;
+  goal.pose.position.y = 2.0;
+  goal.pose.orientation.z = std::sin(M_PI_4);
+  goal.pose.orientation.w = std::cos(M_PI_4);
+  path.poses.push_back(goal);
+
+  EXPECT_TRUE(appendForwardGoalExtension(path, 0.20, 0.0));
+  ASSERT_EQ(path.poses.size(), 5u);
+  EXPECT_NEAR(path.poses.back().pose.position.x, 1.0, 1e-12);
+  EXPECT_NEAR(path.poses.back().pose.position.y, 2.2, 1e-12);
+  EXPECT_NEAR(path.poses.back().pose.orientation.z, goal.pose.orientation.z, 1e-12);
+  EXPECT_FALSE(appendForwardGoalExtension(path, 0.0, 0.0));
+}
+
+TEST(TebUtils, ForwardGoalExtensionContinuesBoundedSignedCurvature) {
+  nav_msgs::msg::Path path;
+  for (int i = 0; i < 2; ++i) {
+    geometry_msgs::msg::PoseStamped pose;
+    const double theta = 0.25 * static_cast<double>(i);
+    pose.pose.position.x = 0.1 * static_cast<double>(i);
+    pose.pose.orientation.z = std::sin(0.5 * theta);
+    pose.pose.orientation.w = std::cos(0.5 * theta);
+    path.poses.push_back(pose);
+  }
+  const double curvature = terminalPathCurvature(path, 2.5);
+  ASSERT_TRUE(appendForwardGoalExtension(path, 0.20, curvature, 0.05));
+  EXPECT_NEAR(curvature, 2.5, 1e-12);
+  EXPECT_NEAR(PoseSE2(path.poses.back().pose).theta(), 0.75, 1e-12);
+}
+
+TEST(TebUtils, ReverseSaturationPreservesCurvatureRatio) {
+  geometry_msgs::msg::Twist cmd;
+  cmd.linear.x = -0.8;
+  cmd.angular.z = 1.0;
+
+  saturateVelocity(cmd, 1.0, 0.0, 1.8, 0.4, true);
+
+  EXPECT_NEAR(cmd.linear.x, -0.4, 1e-12);
+  EXPECT_NEAR(cmd.angular.z, 0.5, 1e-12);
+}
+
+TEST(TebUtils, SteeringRateLimitMovesFromCurrentAngleInSignedDirection) {
+  geometry_msgs::msg::Twist positive;
+  positive.linear.x = 0.5;
+  positive.angular.z = 0.5;
+  saturateSteeringAngle(positive, 0.0, 1.0, 0.5, 0.1);
+  const auto positive_drive = convertTwistToAckermann(positive, 0.5, 0.0);
+  EXPECT_NEAR(positive_drive.second, 0.1, 1e-12);
+
+  geometry_msgs::msg::Twist negative;
+  negative.linear.x = 0.5;
+  negative.angular.z = -0.5;
+  saturateSteeringAngle(negative, 0.0, 1.0, 0.5, 0.1);
+  const auto negative_drive = convertTwistToAckermann(negative, 0.5, 0.0);
+  EXPECT_NEAR(negative_drive.second, -0.1, 1e-12);
+}
+
+TEST(TebUtils, SteeringRateLimitPreservesReachableTargetAngle) {
+  geometry_msgs::msg::Twist command;
+  command.linear.x = 0.5;
+  command.angular.z = 0.1;
+  const auto desired = convertTwistToAckermann(command, 0.5, 0.0);
+  saturateSteeringAngle(command, 0.0, 2.0, 0.5, 0.1);
+  const auto limited = convertTwistToAckermann(command, 0.5, 0.0);
+  EXPECT_NEAR(limited.second, desired.second, 1e-12);
+}
+
