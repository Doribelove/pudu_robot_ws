+bool limitVelocityNearGoal(geometry_msgs::msg::Twist &cmd_vel, double goal_distance,
+                           double slowdown_distance, double minimum_speed,
+                           double maximum_speed) {
+  if (slowdown_distance <= 1e-12 || maximum_speed <= 1e-12 ||
+      cmd_vel.linear.x <= 1e-12 || goal_distance >= slowdown_distance) {
+    return false;
+  }
+
+  const double floor = std::clamp(minimum_speed, 0.0, maximum_speed);
+  const double cap = std::clamp(
+      maximum_speed * std::max(goal_distance, 0.0) / slowdown_distance,
+      floor, maximum_speed);
+  if (cmd_vel.linear.x <= cap) {
+    return false;
+  }
+
+  const double ratio = cap / cmd_vel.linear.x;
+  cmd_vel.linear.x *= ratio;
+  cmd_vel.linear.y *= ratio;
+  cmd_vel.angular.z *= ratio;
+  return true;
+}
