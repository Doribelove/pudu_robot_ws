diff --git a/configs/nav2/controllers/teb/controller_config.yaml b/configs/nav2/controllers/teb/controller_config.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..5caf3e3946557471ddbd3441795bbf67f86f73f3
--- /dev/null
+++ b/configs/nav2/controllers/teb/controller_config.yaml
@@ -0,0 +1,110 @@
+controller_frequency: 20.0
+
+controller_plugins:
+  - FollowPath
+
+controller_plugins_dict:
+  FollowPath:
+    plugin: "nav2_teb_controller::TEBController"
+    log_level: "info"
+    path_tracker:
+      activate: true
+    trajectory:
+      reinit_dist: 2.0
+      reinit_angle: 3.14159
+      # Reset warm-started TEB when a same-goal NavFn replan changes route.
+      reinit_path_dist: 0.35
+      auto_resize: true
+      dt_ref: 0.30
+      dt_hyst: 0.05
+      min_samples: 3
+      max_samples: 40
+      min_seg_length: 0.025
+      max_seg_length: 0.35
+      max_angle_diff: 0.25
+      # NavFn orientations can be discontinuous at grid turns. Recompute the
+      # TEB heading from the geometric path so Jackal does not chase noisy yaw.
+      overwrite_plan_orientation: true
+      # Initialize the band facing along the route. Reverse remains available
+      # to the optimizer for local escape maneuvers, but a route that starts
+      # behind the robot now causes a turn-first maneuver instead of a whole
+      # episode of backward driving.
+      allow_init_backward: false
+      # Average two band segments for a less oscillatory velocity command.
+      control_look_ahead_poses: 2
+      # A fixed 2.5 m window is about 2.1 s at 1.2 m/s: long enough to see a
+      # detour, short enough to react inside Hospital corridors.
+      max_global_plan_lookahead_dist: 2.5
+      global_plan_prune_distance: 0.25
+      control_min_look_ahead_time: 0.0
+      min_prune_distance: 0.025
+    robot:
+      footprint:
+        use_local_costmap: false
+        model: "circles"
+        # Two circles conservatively cover the 0.51 x 0.43 m Jackal rectangle
+        # without the previous model's excessive 0.64 m virtual width.
+        points: "[[-0.1275, 0.0, 0.25], [0.1275, 0.0, 0.25]]"
+      robot_model: "skid_steer"
+      wheelbase: 0.50
+      v_max_x: 1.2
+      # Useful for backing out of dead ends while remaining below forward speed.
+      v_max_x_backwards: 0.4
+      v_max_y: 0.0
+      v_max_theta: 1.8
+      a_max_x: 2.5
+      a_max_y: 0.0
+      a_max_theta: 2.0
+      jerk_max_x: 3.0
+      jerk_max_y: 0.0
+      jerk_max_theta: 4.0
+      min_turning_radius: 0.0
+      has_steering: false
+      use_proportional_saturation: true
+    optimizer:
+      solver: "eigen"
+      algorithm: "levenberg_marquardt"
+      activate: true
+      fast_mode: true
+      no_inner_iterations: 8
+      no_outer_iterations: 4
+      penalty_epsilon: 0.1
+      fix_goal: true
+      free_goal_vel: false
+      verbose: false
+      stepwise_optimization: true
+      early_exit_min_delta: 0.001
+    weights:
+      weight_time_optimal: 1.0
+      weight_shortest_path: 2.0
+      weight_path_smoothness: 4.0
+      # Follow NavFn in free space but let obstacle clearance win locally.
+      weight_viapoint: 30.0
+      weight_v_max_x: 15.0
+      weight_v_max_theta: 10.0
+      weight_a_max_x: 30.0
+      weight_a_max_theta: 40.0
+      # Finite rigidity represents skid-steer tire scrub/slip; vy remains zero.
+      weight_kinematics_nh: 1000.0
+      # Front perception is longer than rear perception on Jackal. A strong,
+      # finite preference makes forward travel the normal solution while
+      # preserving controlled reverse when obstacle feasibility requires it.
+      weight_kinematics_forward_drive: 100.0
+      # Ackermann-only in the planner; retained for other robot presets.
+      weight_g3_continuity: 25.0
+      weight_obstacle: 80.0
+      weight_inflation: 8.0
+    obstacles:
+      include_dynamic_obstacles: false
+      # Hard collision checking covers the complete transformed plan window.
+      feasibility_check: 2.5
+      min_obstacle_cost: 250
+      inflation_dist: 0.60
+      min_obstacle_dist: 0.20
+      cutoff_dist: 0.20
+      costmap_converter_plugin: ""
+      costmap_converter_rate: 2.0
+      costmap_converter_spin_thread: false
+    visualization:
+      activate: false
+      publish_rate: 10.0
