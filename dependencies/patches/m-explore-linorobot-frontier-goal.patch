+geometry_msgs::msg::Point Explore::selectGoal(
+    const frontier_exploration::Frontier& frontier,
+    const geometry_msgs::msg::Point& robot_position) const
+{
+  auto distance_from_robot = [&robot_position](
+                                 const geometry_msgs::msg::Point& point) {
+    return std::hypot(point.x - robot_position.x,
+                      point.y - robot_position.y);
+  };
+
+  // For ordinary frontier shapes the centroid is stable and remains the best
+  // information-gain target. A frontier that wraps around the robot, however,
+  // can have a centroid inside Nav2's goal tolerance and cause a tight loop of
+  // immediately-successful goals.
+  if (distance_from_robot(frontier.centroid) >= minimum_goal_distance_) {
+    return frontier.centroid;
+  }
+
+  geometry_msgs::msg::Point fallback = frontier.centroid;
+  double best_error = std::numeric_limits<double>::max();
+  for (const auto& point : frontier.points) {
+    const double distance = distance_from_robot(point);
+    if (distance < minimum_goal_distance_) {
+      continue;
+    }
+    const double error = std::abs(distance - preferred_goal_distance_);
+    if (error < best_error) {
+      best_error = error;
+      fallback = point;
+    }
+  }
+
+  return fallback;
+}
