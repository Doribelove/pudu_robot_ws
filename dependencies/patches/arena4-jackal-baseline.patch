+        # This pose is simulator ground truth, not a noisy RViz estimate.  A
+        # large covariance makes AMCL re-localize against scan matching and
+        # can move the reported pose by tens of centimetres immediately after
+        # reset.  Keep a tiny non-zero covariance so the message remains a
+        # valid probabilistic estimate while preserving the exact reset pose.
+        pose.pose.covariance[0] = 1e-6
+        pose.pose.covariance[7] = 1e-6
+        pose.pose.covariance[35] = math.radians(0.1) ** 2
+
+        topic = self.node.service_namespace(robot.name, "initialpose")
+        publisher = self._initial_pose_publishers.get(robot.name)
+        if publisher is None:
+            publisher = self.node.create_publisher(
+                PoseWithCovarianceStamped,
+                topic,
+                qos_profile=1,
+            )
+            self._initial_pose_publishers[robot.name] = publisher
+
+        if not require_delivery:
+            # The spawn-time publication happens before Nav2 exists. Keep the
+            # publisher alive so discovery is already complete at the task
+            # reset.
+            publisher.publish(pose)
+            return publisher.get_subscription_count() > 0
+
+        service = self.node.service_namespace(robot.name, "set_initial_pose")
+        client = self._initial_pose_clients.get(robot.name)
+        if client is None:
+            client = self.node.create_client(SetInitialPose, service)
+            self._initial_pose_clients[robot.name] = client
+
+        if client.wait_for_service(timeout_sec=5.0):
+            request = SetInitialPose.Request()
+            request.pose = pose
+            response = client.call(request)
+            if response is not None:
+                self._logger.info(
+                    f"AMCL initial pose set for {robot.name}: "
+                    f"x={robot.pose.position.x:.3f}, y={robot.pose.position.y:.3f}, "
+                    f"yaw={robot.pose.orientation.to_yaw():.3f}"
+                )
+                return True
+
+        # Compatibility fallback for AMCL variants without the service. Wait
