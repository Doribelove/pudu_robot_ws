# Test-only private stage, never the configured production install prefix.
set(stage "@CMAKE_CURRENT_BINARY_DIR@/test_install")
set(marker "${stage}/.trilayer_test_stage_owned")
if(EXISTS "${stage}")
 if(NOT EXISTS "${marker}")
  message(FATAL_ERROR "Refusing to replace unowned test stage: ${stage}")
 endif()
 file(REMOVE_RECURSE "${stage}")
endif()
file(MAKE_DIRECTORY "${stage}")
file(WRITE "${marker}" "@PROJECT_NAME@ test fixture only\n")
execute_process(COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "${stage}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Private stage install failed: ${result}")
endif()
