<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    SCURM simulation owns odom -> base_footprint through FAST-LIO.  Gazebo
    therefore publishes wheel odometry only as a topic, never as TF.  Wheel
    poses are reconstructed from joint_states by robot_state_publisher so
    every child frame has exactly one TF parent.
  -->
  <xacro:macro name="scurm_sim_drive_controller"
               params="wheel_separation wheel_radius wheel_torque">
    <gazebo>
      <plugin name="differential_drive_controller"
              filename="libgazebo_ros_diff_drive.so">
        <ros>
          <remapping>odom:=odom/unfiltered</remapping>
        </ros>
        <update_rate>100</update_rate>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>${wheel_separation}</wheel_separation>
        <wheel_diameter>${wheel_radius * 2}</wheel_diameter>
        <max_wheel_torque>${wheel_torque}</max_wheel_torque>
        <max_wheel_acceleration>1.0</max_wheel_acceleration>
        <robot_base_frame>base_footprint</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <odometry_frame>odom</odometry_frame>
      </plugin>

      <plugin name="scurm_joint_state_publisher"
              filename="libgazebo_ros_joint_state_publisher.so">
        <ros>
          <remapping>~/out:=joint_states</remapping>
        </ros>
        <update_rate>30</update_rate>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
