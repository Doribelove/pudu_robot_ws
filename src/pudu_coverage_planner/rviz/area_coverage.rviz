        - Alpha: 0.5799999833106995
          Class: rviz_default_plugins/GridCells
          Color: 0; 205; 80
          Enabled: true
          Name: 已扫描区域（绿色）
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage/covered_cells
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 188; 20
          Enabled: true
          Head Diameter: 0.07999999821186066
          Head Length: 0.10000000149011612
          Length: 0.30000001192092896
          Line Style: Billboards
          Line Width: 0.06499999761581421
          Name: 待执行弓形路线（黄色）
          Offset:
            X: 0
            Y: 0
            Z: 0.05999999865889549
          Pose Color: 255; 188; 20
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.029999999329447746
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage/path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 30; 145; 255
          Enabled: true
          Head Diameter: 0.07999999821186066
          Head Length: 0.10000000149011612
          Length: 0.30000001192092896
          Line Style: Billboards
          Line Width: 0.054999999701976776
          Name: 实际已走路线（蓝色）
          Offset:
            X: 0
            Y: 0
            Z: 0.07999999821186066
          Pose Color: 30; 145; 255
          Pose Style: None
          Radius: 0.029999999329447746
          Shaft Diameter: 0.029999999329447746
          Shaft Length: 0.10000000149011612
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /coverage/traveled_path
