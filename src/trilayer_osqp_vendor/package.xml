<?xml version="1.0"?>
<package format="3">
  <name>trilayer_osqp_vendor</name><version>0.1.0</version>
  <description>Offline source build of fixed OSQP and QDLDL Python extensions for TriLayer.</description>
  <maintainer email="doribelove@gmail.com">Doribelove</maintainer>
  <license>Apache-2.0</license><license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend><buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>python3-dev</build_depend><build_depend>python3-setuptools</build_depend>
  <build_depend>python3-wheel</build_depend><build_depend>python3-numpy</build_depend>
  <build_depend>python3-scipy</build_depend><build_depend>pybind11-dev</build_depend>
  <!-- Apt packages exist on Jammy. Proposed rosdep keys require upstream review. -->
  <build_depend>python3-setuptools-scm</build_depend><build_depend>python3-pybind11</build_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <url type="repository">https://github.com/Doribelove/pudu_robot_ws</url>
<url type="bugtracker">https://github.com/Doribelove/pudu_robot_ws/issues</url>
<export><build_type>ament_cmake</build_type></export>
</package>
