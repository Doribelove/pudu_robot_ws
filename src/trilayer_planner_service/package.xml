<?xml version="1.0"?>
<package format="3">
<name>trilayer_planner_service</name><version>0.1.0</version>
<description>Bounded local IPC worker for persistent original P6 planning sessions.</description>
<maintainer email="doribelove@gmail.com">Doribelove</maintainer><license>Apache-2.0</license>
<buildtool_depend>ament_cmake</buildtool_depend><buildtool_depend>ament_cmake_python</buildtool_depend>
<exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
<exec_depend>trilayer_p6_runtime</exec_depend><exec_depend>python3-numpy</exec_depend><exec_depend>python3-pil</exec_depend><exec_depend>python3-psutil</exec_depend><exec_depend>python3</exec_depend>
<url type="repository">https://github.com/Doribelove/pudu_robot_ws</url>
<url type="bugtracker">https://github.com/Doribelove/pudu_robot_ws/issues</url>
<!-- Direct test imports and exercised integration dependencies; not build exports. -->
<test_depend>python3-psutil</test_depend>
<test_depend>python3-numpy</test_depend>
<test_depend>python3-pil</test_depend>
<test_depend>trilayer_p6_runtime</test_depend>
<export><build_type>ament_cmake</build_type></export></package>
